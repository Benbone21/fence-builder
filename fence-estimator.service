# Copy to /etc/systemd/system/, fix the paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now fence-estimator
[Unit]
Description=Fence Builder
After=network-online.target

[Service]
WorkingDirectory=/opt/fence-estimator
ExecStart=/usr/bin/python3 /opt/fence-estimator/server.py
Environment=PORT=8787
# a shared server: everyone signs in with their own account (see README.md and SECURITY.md)
Environment=FENCE_MODE=multi
Environment=FENCE_DATA=/opt/fence-estimator/data/fence-data.json
Restart=on-failure
User=www-data

[Install]
WantedBy=multi-user.target
