# Settings for docker compose. Copy this file to .env (cp .env.example .env) and change what you need.
# Nothing secret goes in here.

# The port people open, on every network address of the server: http://<server address>:8787
FENCE_PUBLISH=8787

# ---- Only when the server has a domain name and https (docker compose --profile https up -d) ----
# The domain name, already pointing at this server, with ports 80 and 443 open to the internet:
#FENCE_DOMAIN=fence.example.com
# The address people use, for the one-time invite links:
#FENCE_PUBLIC_URL=https://fence.example.com
# Keep the plain-http port for this machine only, so everyone goes through https:
#FENCE_PUBLISH=127.0.0.1:8787
# Only answer to these names (the domain, and the server's own address if people use that inside):
#FENCE_ALLOWED_HOSTS=fence.example.com

# Who may save map areas for offline use on the server: all, admin or off
#FENCE_OFFLINE=all
